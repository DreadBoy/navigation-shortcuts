<?xml version="1.0" encoding="utf-8"?>
<!-- Filled cell, icon size "default" (44 dp; decisions 5b U/E19): icon and label left-aligned on the cell's start edge,
     so the first column lines up with Niagara's app icon column. The icon is 44 dp and shrinks (weight) when the row
     is too short; the group is centred vertically in the row. Same ids in all sizes (E2E). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cell_root"
    style="@style/WidgetCell">

    <!-- Separate views, not a compound drawable: RemoteViews sets the icon as a bitmap. -->
    <LinearLayout
        style="@style/WidgetCellContent"
        tools:ignore="UseCompoundDrawables">

        <ImageView
            android:id="@+id/cell_icon"
            style="@style/WidgetCellIcon"
            android:importantForAccessibility="no"
            android:layout_width="44dp"
            android:layout_height="44dp" />

        <TextView
            android:id="@+id/cell_label"
            style="@style/WidgetCellLabel"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
