<?xml version="1.0" encoding="utf-8"?>
<!-- Per-widget config screen (PLAN 4.1, decisions 4.1): grid size, icon style with live preview, destination list. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/config_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/config_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/config_title"
                android:textAppearance="@android:style/TextAppearance.DeviceDefault.Large" />

            <TextView
                android:id="@+id/config_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/config_share_tip"
                android:textColor="?android:attr/textColorSecondary" />

            <!-- Grid -->
            <TextView
                style="@style/ConfigSection"
                android:text="@string/config_grid" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/ConfigFieldLabel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/config_rows" />

                <Button
                    android:id="@+id/rows_minus"
                    style="@style/StepperButton"
                    android:contentDescription="@string/rows_minus"
                    android:text="@string/minus" />

                <TextView
                    android:id="@+id/rows_value"
                    style="@style/StepperValue" />

                <Button
                    android:id="@+id/rows_plus"
                    style="@style/StepperButton"
                    android:contentDescription="@string/rows_plus"
                    android:text="@string/plus" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/ConfigFieldLabel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/config_cols" />

                <Button
                    android:id="@+id/cols_minus"
                    style="@style/StepperButton"
                    android:contentDescription="@string/cols_minus"
                    android:text="@string/minus" />

                <TextView
                    android:id="@+id/cols_value"
                    style="@style/StepperValue" />

                <Button
                    android:id="@+id/cols_plus"
                    style="@style/StepperButton"
                    android:contentDescription="@string/cols_plus"
                    android:text="@string/plus" />
            </LinearLayout>

            <TextView
                android:id="@+id/grid_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorSecondary"
                android:visibility="gone" />

            <TextView
                android:id="@+id/grid_tall_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/config_tall_tip"
                android:textColor="?android:attr/textColorSecondary"
                android:visibility="gone" />

            <!-- Icon style -->
            <TextView
                style="@style/ConfigSection"
                android:text="@string/config_style" />

            <LinearLayout
                android:id="@+id/style_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/icon_preview_background"
                android:contentDescription="@string/style_preview"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="12dp" />

            <TextView
                android:id="@+id/style_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/niagara_missing_style"
                android:textColor="?android:attr/textColorSecondary"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/ConfigFieldLabel"
                    android:text="@string/config_pack" />

                <Spinner
                    android:id="@+id/style_pack"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/style_dimensions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/shape_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/ConfigFieldLabel"
                    android:text="@string/config_shape" />

                <Spinner
                    android:id="@+id/style_shape"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </LinearLayout>

            <TextView
                android:id="@+id/color_label"
                style="@style/ConfigFieldLabel"
                android:layout_width="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/config_color" />

            <LinearLayout
                android:id="@+id/color_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal" />

            <!-- After the pack's own settings (decisions 5b E25): size applies to every pack. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/ConfigFieldLabel"
                    android:text="@string/config_icon_size" />

                <Spinner
                    android:id="@+id/icon_size"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:contentDescription="@string/config_icon_size" />
            </LinearLayout>

            <!-- Destinations -->
            <TextView
                style="@style/ConfigSection"
                android:text="@string/config_destinations" />

            <TextView
                android:id="@+id/empty_list_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="@string/config_no_destinations"
                android:textColor="?android:attr/textColorSecondary" />

            <LinearLayout
                android:id="@+id/entry_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <Button
                android:id="@+id/add_manual_button"
                style="@style/ConfigTextButton"
                android:layout_marginStart="-12dp"
                android:text="@string/add_manually_plus" />

            <TextView
                android:id="@+id/add_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/grid_full_max"
                android:textColor="?android:attr/textColorSecondary"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <!-- Undo after a delete (decisions 5b E18): a snackbar-like bar, no Material dependency. -->
    <LinearLayout
        android:id="@+id/undo_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/undo_bar_background"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/undo_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityLiveRegion="polite"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/undo_bar_text" />

        <Button
            android:id="@+id/undo_button"
            style="@android:style/Widget.DeviceDefault.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/undo"
            android:textAllCaps="false"
            android:textColor="@color/undo_bar_action" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <Button
            android:id="@+id/config_cancel"
            style="@style/ConfigTextButton"
            android:text="@string/cancel" />

        <Button
            android:id="@+id/config_save"
            style="@style/ConfigTextButton"
            android:text="@string/save" />
    </LinearLayout>
</LinearLayout>
