<?xml version="1.0" encoding="utf-8"?>
<!-- Add/Edit destination in the config screen (decisions 5b E24, E14): icon (tap → the shared icon picker) and
     persistent field labels above the fields, plus how the label will show on the widget when it is too long. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp">

        <TextView
            style="@style/SheetFieldLabel"
            android:layout_marginTop="4dp"
            android:text="@string/field_label" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/dialog_icon"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/icon_preview_background"
                android:contentDescription="@string/change_icon"
                android:padding="4dp"
                android:scaleType="fitCenter" />

            <EditText
                android:id="@id/dialog_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:autofillHints=""
                android:hint="@string/label_hint"
                android:inputType="textCapWords"
                android:maxLines="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/dialog_label_fit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@android:style/TextAppearance.DeviceDefault.Small"
            android:textColor="?android:attr/textColorSecondary"
            android:visibility="gone" />

        <TextView
            style="@style/SheetFieldLabel"
            android:text="@string/field_destination" />

        <EditText
            android:id="@id/dialog_destination"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints=""
            android:hint="@string/destination_hint"
            android:inputType="textPostalAddress"
            android:maxLines="1" />
    </LinearLayout>
</ScrollView>
