<?xml version="1.0" encoding="utf-8"?>
<!-- App launcher screen (PLAN 4.2, decisions 5b E15): placed widgets as tappable cards (tap → that widget's settings),
     then Niagara's real steps to add the widget and how to add destinations. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAppearance="@android:style/TextAppearance.DeviceDefault.Large" />

        <TextView
            style="@style/ConfigSection"
            android:text="@string/main_widgets" />

        <TextView
            android:id="@+id/no_widgets_text"
            style="@style/ConfigBody"
            android:text="@string/main_no_widgets"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/widget_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Places left on a widget Niagara replaced (decisions 5b E5 round 2): offer to move them. -->
        <LinearLayout
            android:id="@+id/stranded_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/stranded_text"
                style="@style/ConfigBody" />

            <Button
                android:id="@+id/stranded_move"
                style="@style/ConfigTextButton"
                android:layout_marginStart="-12dp" />
        </LinearLayout>

        <TextView
            style="@style/ConfigSection"
            android:text="@string/main_add_widget" />

        <TextView
            android:id="@+id/add_widget_steps"
            style="@style/ConfigBody"
            android:lineSpacingExtra="4dp"
            android:text="@string/main_add_widget_steps" />

        <TextView
            style="@style/ConfigBody"
            android:layout_marginTop="8dp"
            android:text="@string/main_other_launchers" />

        <TextView
            style="@style/ConfigSection"
            android:text="@string/main_add_places" />

        <TextView
            style="@style/ConfigBody"
            android:text="@string/main_add_places_steps" />
    </LinearLayout>
</ScrollView>
