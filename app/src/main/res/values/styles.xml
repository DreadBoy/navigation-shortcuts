<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Share target styled as a bottom sheet over Google Maps (no full-screen activity). -->
    <style name="Theme.NavShort.BottomSheet" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@drawable/bottom_sheet_background</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:windowSoftInputMode">adjustResize|stateHidden</item>
    </style>

    <!-- Widget cells (decisions 5b U/E19), shared by the placed widget and the picker preview. -->
    <style name="WidgetCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:paddingEnd">4dp</item>
    </style>

    <style name="WidgetCellContent">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">start|center_vertical</item>
        <item name="android:orientation">vertical</item>
    </style>

    <!-- Size set per layout (the size setting); weight 1 in a wrap_content column lets it shrink, never grow, in a
         short row. -->
    <style name="WidgetCellIcon">
        <item name="android:layout_weight">1</item>
        <item name="android:importantForAccessibility">no</item>
        <!-- fitStart: a shrunk icon stays on the column's start edge. -->
        <item name="android:scaleType">fitStart</item>
    </style>

    <!-- Like Niagara's home-screen labels: white, sans-serif, soft shadow (size per icon size). -->
    <style name="WidgetCellLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <!-- Room for the shadow, which the view would clip; 1 dp keeps the text on the icon's edge. -->
        <item name="android:paddingStart">1dp</item>
        <item name="android:paddingEnd">2dp</item>
        <item name="android:shadowColor">#99000000</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">4</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <!-- Full-screen config screen and app screen: own title, no action bar. -->
    <style name="Theme.NavShort.Config" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowSoftInputMode">adjustResize|stateHidden</item>
        <!-- Dark status/navigation bar icons on the light background, light ones in dark mode (decisions 5b E16). -->
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_system_bars</item>
    </style>

    <style name="ConfigSection">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textAppearance">@android:style/TextAppearance.DeviceDefault.Medium</item>
        <item name="android:textColor">?android:attr/colorAccent</item>
    </style>

    <style name="ConfigFieldLabel">
        <item name="android:layout_width">96dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>

    <!-- One look for every control of the settings screen (decisions 5b E25): flat, rounded, accent-coloured. -->
    <style name="StepperButton" parent="@android:style/Widget.DeviceDefault.Button.Borderless">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:background">@drawable/stepper_background</item>
        <item name="android:textColor">@color/accent_text</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="ConfigTextButton" parent="@android:style/Widget.DeviceDefault.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/accent_text</item>
    </style>

    <style name="ConfigBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>

    <style name="StepperValue">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textAppearance">@android:style/TextAppearance.DeviceDefault.Medium</item>
    </style>

    <style name="SheetFieldLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:textAppearance">@android:style/TextAppearance.DeviceDefault.Small</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>
</resources>
