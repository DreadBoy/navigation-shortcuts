<?xml version="1.0" encoding="utf-8"?>
<!-- Tappable card (app screen widget rows, decisions 5b E15): a raised surface (white on the light background, lighter
     grey on the dark one) with a thin outline and a ripple, so it reads as active, not disabled. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?android:attr/colorControlHighlight">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/card_background" />
            <stroke android:width="1dp" android:color="@color/card_outline" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</ripple>
