<?xml version="1.0" encoding="utf-8"?>
<!-- Grid layout comes from the stored config, not from the reported size (Niagara reports sizes unreliably,
     decisions 1.3); cells are weighted to fill the slot.
     configure + reconfigurable: Niagara's long-press "Change widget settings" opens our config (decisions 1.4a);
     configuration_optional: placement needs no config (decisions 4.1). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="io.github.dreadboy.navigationshortcuts.WidgetConfigActivity"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_grid"
    android:minWidth="40dp"
    android:minHeight="40dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:previewLayout="@layout/widget_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable|configuration_optional" />
