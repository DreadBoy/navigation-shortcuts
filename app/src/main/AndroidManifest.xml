<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Resolving the shared maps.app.goo.gl link once at add time (decisions 1.5). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <queries>
        <package android:name="com.google.android.apps.maps" />
        <!-- Anycon glyphs and textures are read from the installed Niagara at runtime (decisions 5.3). -->
        <package android:name="bitpit.launcher" />
    </queries>

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.NavShort.Config">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Share target: Google Maps → Share → "Add to navigation widget" (spec Flow 2). -->
        <activity
            android:name=".AddDestinationActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/share_target_label"
            android:theme="@style/Theme.NavShort.BottomSheet">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Per-widget config (PLAN 4.1): launcher configure/reconfigure ("Change widget settings" in Niagara), empty
             widget cells (own task) and the app's widget list. Exported because the launcher starts it. -->
        <activity
            android:name=".WidgetConfigActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/config_title"
            android:taskAffinity=""
            android:theme="@style/Theme.NavShort.Config">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".NavigationWidgetProvider"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/navigation_widget_info" />
        </receiver>

        <!-- Serves the widget's invisible 1 px probe image; the launcher loading it means "this widget is displayed"
             (decisions 3.9). Exported because the launcher process reads it; it only ever returns a transparent pixel. -->
        <provider
            android:name=".RenderProbeProvider"
            android:authorities="${applicationId}.renderprobe"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />

        <!-- requestPinAppWidget success callback (explicit PendingIntent from our own share sheet). -->
        <receiver
            android:name=".PinWidgetCallbackReceiver"
            android:exported="false" />
    </application>
</manifest>
